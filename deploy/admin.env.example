# Origin is the browser origin, without trailing slash or path.
AUROSA_ADMIN_ORIGIN=https://admin.example.com
# Tailscale clients connect to Headscale here, not to the admin web service.
HEADSCALE_URL=https://headscale.example.com
AUROSA_ADMIN_AUTH=/etc/headscale-admin/auth.json
AUROSA_ADMIN_COOKIE_PATH=/
AUROSA_ADMIN_PORT=18444
AUROSA_ADMIN_GROUP=admin
HEADSCALE_BIN=/usr/local/bin/headscale
HEADSCALE_CONFIG=/etc/headscale/config.yaml
HEADSCALE_DB=/var/lib/headscale/db.sqlite

# Optional: only enable on Headscale 0.29.6 with SQLite, after backing up the DB.
HEADSCALE_ALLOW_DB_KEYS=0
